{
  "info": {
    "name": "Booking API",
    "description": "Коллекция API онлайн-букинга — все эндпоинты с тестами",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{ACCESS_TOKEN}}", "type": "string" }]
  },
  "item": [
